# Server
NODE_ENV=development
PORT=5001

# Postgres (docker-compose service name = "postgres")
DATABASE_URL=postgresql://teamit:teamit@localhost:5432/teamit?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
BUCKET_NAME=teamit

# HTTPS (optional — only needed in production)
# SSL_KEY_PATH=/etc/letsencrypt/live/teamitserver.ru/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/teamitserver.ru/fullchain.pem
